# ── LLM (DeepSeek is the ONLY hosted LLM provider) ─────────────────────────
# DeepSeek's OpenAI-compatible API. The client is configured explicitly for
# https://api.deepseek.com — no requests ever go to OpenAI.
DEEPSEEK_API_KEY=

# Optional. Defaults to "deepseek-chat".
DEEPSEEK_MODEL=deepseek-chat

# ── Embeddings (local, no paid embeddings API) ─────────────────────────────
# Model runs locally via sentence-transformers. 384-dim output, stored in pgvector.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Database (PostgreSQL + pgvector) ───────────────────────────────────────
# Connection string, e.g.:
#   postgresql+psycopg://user:password@host:5432/energy_rag
DATABASE_URL=

# ── Structured energy data (U.S. EIA) ──────────────────────────────────────
# Used by the ingestion pipeline to pull verified price series via the EIA API.
EIA_API_KEY=

# ── Model cache (Railway: keep the downloaded model inside the image) ──────
# Point this at a directory baked into the Docker image so the embedding model
# is not re-downloaded on every cold start.
HF_HOME=/app/.hf_cache

# ── Security / resilience ──────────────────────────────────────────────────
# Guards all /admin/* and ingestion endpoints via the X-Admin-Key header.
# If unset, those endpoints are disabled (fail closed).
ADMIN_API_KEY=

# Per-IP rate limit for /ask and /debug/retrieval. 0 disables limiting.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60
